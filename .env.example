# ---------------------------------------------------------------------------
# The Good Dentist — environment template.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# never commit real credentials. Never overwrite an existing `.env` blindly.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required for booking APIs).
# Local example — see docs/BACKEND.md for setup:
# The app appends "options=-c timezone=UTC" to this URL automatically so every
# connection runs with a UTC session (required by @prisma/adapter-pg's naive
# timestamp serialization — see docs/BACKEND.md → "Timestamp timezone integrity").
# If you add your own "options" param, include "-c timezone=UTC" in it yourself.
DATABASE_URL="postgresql://postgres:password@localhost:5432/the_good_dentist?schema=public"

# Secret used to sign staff session cookies (HMAC-SHA256).
# Generate one with:  openssl rand -base64 48
# Required for staff login; when missing, auth endpoints return 503.
SESSION_SECRET=""

# Optional overrides (sensible defaults exist in lib/server/env.ts).
SESSION_COOKIE_NAME="tgd_session"

# Public site URL used for canonical links/SEO (pending real domain).
# NEXT_PUBLIC_SITE_URL="https://thegooddentist.example.com"

# ---------------------------------------------------------------------------
# Phase D — private dental X-ray storage (Cloudflare R2) + storage cron.
# Server-side ONLY: read in lib/server/env.ts, never exposed to the browser
# (never NEXT_PUBLIC_*). The four R2_* values are required TOGETHER; when any
# is missing, dental file endpoints answer 503 and the cleanup workers skip
# the R2-touching jobs (they never fake success). Local development and all
# automated tests use the in-memory storage fake — R2 is NOT needed to run
# the app locally. External setup steps: docs/BACKEND.md → "Dental records &
# private X-ray storage"; deployment checklist: docs/MANUAL_DEPLOYMENT_GUIDE.md §7.
# ---------------------------------------------------------------------------
# R2_ACCOUNT_ID=""        # Cloudflare account id (R2 dashboard → overview)
# R2_BUCKET=""            # private bucket name, e.g. the-good-dentist-dental
# R2_ACCESS_KEY_ID=""     # R2 API token, Object Read & Write, bucket-scoped
# R2_SECRET_ACCESS_KEY="" # the token's secret (shown once — store it safely)

# Optional (F-5): maximum number of files ONE dental record may hold.
# Checked under a record-row lock (race-safe) — hitting the limit returns
# 409, never a silent truncation. Default 50; valid range 1..500.
# DENTAL_MAX_FILES_PER_RECORD=50

# Shared secret for the Vercel cron route
# (GET /api/cron/dental-storage-cleanup, `Authorization: Bearer <secret>`).
# Required in production (>= 32 chars): when missing the route fails CLOSED
# with 503 and never runs unauthenticated.
# Generate one with:  openssl rand -base64 48
# CRON_SECRET=""

# ---------------------------------------------------------------------------
# Only used by offline scripts (npm run staff:create) — never by the web app.
# Prefer passing STAFF_PASSWORD interactively/via CI secret instead of a file.
# ---------------------------------------------------------------------------
# STAFF_EMAIL="admin@thegooddentist.example.com"
# STAFF_PASSWORD=""
