// Prisma schema — The Good Dentist appointment backend.
//
// Design notes (Phase 2):
//  - Times are stored as `timestamptz` (UTC instants). All schedule rules are
//    evaluated in the clinic timezone configured in `ClinicConfig.timezone`
//    (Asia/Kolkata) by `lib/server/schedule.ts`.
//  - Clinic schedule, slot interval and booking policy are DATA (ClinicConfig
//    / ClinicHour), seeded from the client-confirmed values in
//    `prisma/seed.ts` — never hardcoded across backend files.
//  - Appointment durations on Service are PROVISIONAL (not yet approved by
//    the clinic) — `durationIsProvisional` keeps that visible in the data.
//  - Double booking is prevented in depth:
//      1. per-doctor `pg_advisory_xact_lock` + overlap re-check inside the
//         booking transaction (lib/server/appointments.ts),
//      2. a PostgreSQL exclusion constraint (`tstzrange` overlap per doctor,
//         active statuses only) added as raw SQL in the initial migration —
//         Prisma PSL cannot express exclusion constraints, so it lives in the
//         migration file. It protects against races across app instances.
//  - Patient PII is kept minimal; there is no unique constraint on phone
//    (two different people may share one number) and no public search path.
//  - Future phases extend this schema (dental records, X-ray attachments,
//    inventory, reminders, richer permissions) — see docs/BACKEND.md.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ------------------------------------------------------------------ *
 * Clinic configuration (single row)
 * ------------------------------------------------------------------ */

model ClinicConfig {
  id                  String        @id @default("singleton")
  clinicName          String
  timezone            String        @default("Asia/Kolkata")
  address             String
  phone               String
  whatsappNumber      String
  email               String
  /// PROVISIONAL — 30-minute slot interval not yet approved by the clinic.
  slotIntervalMinutes Int           @default(30)
  bookingPolicy       BookingPolicy @default(MANUAL_APPROVAL)
  hours               ClinicHour[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

enum BookingPolicy {
  /// Staff must confirm every booking request (current default — the client
  /// has not approved automatic confirmation).
  MANUAL_APPROVAL
  /// Reserved for when/if the clinic approves automatic confirmation.
  AUTO_CONFIRM
}

model ClinicHour {
  id                String       @id @default(cuid())
  config            ClinicConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId          String
  /// 0 = Sunday … 6 = Saturday (clinic-local).
  weekday           Int
  closed            Boolean      @default(false)
  /// Minutes from midnight (540 = 9:00 AM, 1260 = 9:00 PM).
  opensAtMinutes    Int          @default(540)
  closesAtMinutes   Int          @default(1260)
  breakStartMinutes Int?
  breakEndMinutes   Int?

  @@unique([configId, weekday])
}

/* ------------------------------------------------------------------ *
 * Patients (minimal PII)
 * ------------------------------------------------------------------ */

model Patient {
  id           String        @id @default(cuid())
  fullName     String
  /// E.164-ish digits; NOT unique — identity never matches on phone alone.
  phone        String
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  clinicalNotes ClinicalNote[]
  dentalRecords DentalRecord[]

  @@index([phone])
}

/* ------------------------------------------------------------------ *
 * Internal clinical notes (Phase C — ADMIN-only, never public)
 * ------------------------------------------------------------------ */

model ClinicalNote {
  id        String   @id @default(cuid())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  /// Author (null when the staff account was deleted — note is retained).
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId   String?
  /// Internal clinical text. Rendered only inside the guarded admin panel.
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
}

/* ------------------------------------------------------------------ *
 * Doctors
 * ------------------------------------------------------------------ */

model Doctor {
  id              String        @id @default(cuid())
  /// Public-safe identifier (slug), never the database id.
  slug            String        @unique
  name            String
  qualifications  String[]
  experienceYears Int?
  areasOfPractice String[]
  bio             String?
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
}

/* ------------------------------------------------------------------ *
 * Services
 * ------------------------------------------------------------------ */

model Service {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  description String?
  /// PROVISIONAL — indicative booking length, not client-approved.
  durationMinutes Int
  /// True while `durationMinutes` still needs clinic approval.
  durationIsProvisional Boolean @default(true)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointments Appointment[]
}

/* ------------------------------------------------------------------ *
 * Appointments
 * ------------------------------------------------------------------ */

model Appointment {
  id       String            @id @default(cuid())
  /// Public-safe identifier handed to patients (random, non-sequential).
  publicId String            @unique
  patient  Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId String
  doctor   Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  doctorId String
  service  Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId String
  startsAt DateTime          @db.Timestamptz()
  endsAt   DateTime          @db.Timestamptz()
  status   AppointmentStatus @default(PENDING)
  source   BookingSource     @default(WEBSITE)
  /// Non-clinical scheduling note only — never store medical details here.
  patientNotes       String?
  cancellationReason String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Supports the per-doctor availability query and the exclusion-constraint
  // maintenance plan.
  @@index([doctorId, status, startsAt])
  @@index([status, startsAt])
  @@index([patientId])
}

/// Slot-reserving statuses are PENDING and CONFIRMED (see the exclusion
/// constraint in the initial migration and VALID_TRANSITIONS in
/// lib/server/appointments.ts).
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  WEBSITE
  WHATSAPP
  STAFF
}

/* ------------------------------------------------------------------ *
 * Staff auth (sessions + audit trail groundwork)
 * ------------------------------------------------------------------ */

model Staff {
  id           String           @id @default(cuid())
  /// Login identifier; accounts are created offline, never via a public API.
  email        String           @unique
  fullName     String
  /// scrypt hash (`scrypt$N,r,p$salt$hash`) — see lib/server/auth.ts.
  passwordHash String
  role         StaffRole        @default(STAFF)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     StaffSession[]
  auditLogs    AuditLog[]
  clinicalNotes ClinicalNote[]
  /// Dental records authored by this staff member (Phase D).
  dentalRecords DentalRecord[]   @relation("DentalRecordAuthor")
  /// Dental files uploaded by this staff member (Phase D).
  dentalFiles   DentalFile[]     @relation("DentalFileUploader")
}

enum StaffRole {
  ADMIN
  STAFF
}

model StaffSession {
  /// SHA-256 of the signed cookie value (never the raw token).
  id        String   @id
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([staffId])
}

model AuditLog {
  id       String  @id @default(cuid())
  staff    Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId  String?
  /// e.g. "appointment.confirm", "appointment.cancel", "staff.login".
  action   String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/* ------------------------------------------------------------------ *
 * Phase D — dental records + private X-ray file storage (Cloudflare R2)
 *
 * Design rules (approved across planning Rounds 1–12):
 *  - Objects live in a PRIVATE R2 bucket; the browser talks to R2 only via
 *    short-lived presigned URLs issued after an ADMIN-only server check.
 *    No public URLs, ever. R2 credentials never leave the server.
 *  - `DentalFile.r2Key` is IMMUTABLE after creation and every key is
 *    reserved in `R2KeyRegistry` (a permanent tombstone) inside the SAME
 *    transaction that creates the file row — a retired key can never be
 *    re-issued (see lib/server/admin/dental-files.ts).
 *  - Deletion is two-phase: an intent (status DELETING, or a
 *    `StorageDeletionReceipt` for orphans) is always durable BEFORE the
 *    external DeleteObject call, and every physical deletion is followed by
 *    a HEAD confirmation before the row/audit is finalised.
 *  - The orphan reconciler (Job D) never deletes a row-backed object: row
 *    existence is the first predicate, and the 48 h grace is recomputed
 *    from the CURRENT HeadObject timestamp (LIST timestamps are an
 *    optimization only — never authorization).
 * ------------------------------------------------------------------ */

model DentalRecord {
  id        String   @id @default(cuid())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  /// Date the treatment happened (clinic-local calendar date, DATE column).
  treatmentDate DateTime @db.Date
  diagnosis       String
  treatmentDetails String
  /// Optional free-form clinical notes attached to the record itself.
  clinicalNotes   String?
  /// Author (null when the staff account was deleted — record is retained).
  author  Staff?  @relation("DentalRecordAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Soft delete: the record (and its files) are removed by the cleanup
  /// workers — Job C purges the row only once zero files remain.
  deletedAt DateTime?
  files     DentalFile[]

  @@index([patientId, treatmentDate])
  @@index([treatmentDate])
  @@index([deletedAt])
}

enum DentalFileStatus {
  /// Row reserved + presigned URL issued; object not yet confirmed.
  PENDING
  /// Server verified size + magic bytes; safe to view/download.
  AVAILABLE
  /// Server verification failed — the object is swept, never served.
  REJECTED
  /// Deletion requested (admin/record-delete/sweep); worker finalises.
  DELETING
}

model DentalFile {
  id       String        @id @default(cuid())
  record   DentalRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordId String
  /// Server-generated, never user-supplied:
  /// `dental/{patientId}/{recordId}/{fileId}.{ext}` — IMMUTABLE.
  r2Key    String        @unique
  originalName String
  contentType  String
  byteSize     Int
  status   DentalFileStatus @default(PENDING)
  /// No physical delete may run before this instant (URL TTL 300 s +
  /// 300 s buffer for in-flight requests = createdAt + 600 s).
  cleanupAfter DateTime
  cleanupAttempts Int     @default(0)
  /// Uploader (null when the staff account was deleted).
  uploader Staff?      @relation("DentalFileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  uploadedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recordId, createdAt])
  @@index([status, cleanupAfter])
}

/// Singleton row backing the orphan reconciler's durable cursor + lease.
model StorageScanState {
  /// Fixed primary key — exactly one row (`dental_orphan_scan`).
  id String @id @default("dental_orphan_scan")
  /// Durable LIST cursor (null = cycle not started / cycle complete).
  lastScannedKey String?
  /// Worker id holding the lease (null = free).
  leaseOwner String?
  /// Expiry instant; the lease is held iff owner matches AND not expired.
  leaseExpiresAt DateTime?
  updatedAt DateTime @updatedAt
}

/// One deletion EVENT per row: `r2Key` alone is a location, not an identity
/// (one key can host many events over its lifetime). Event identity = the
/// cuid PK; natural identity = (r2Key, eventNo). Completed receipts are
/// NEVER reused — a conflict aborts the intent before any DeleteObject.
model StorageDeletionReceipt {
  id        String    @id @default(cuid())
  r2Key     String
  /// Per-key event sequence: 1, 2, 3 … (allocated inside the intent tx).
  eventNo   Int
  /// Diagnostic evidence captured at intent time (HeadObject snapshot).
  /// NEVER used to authorize a deletion — authoritative age always comes
  /// from a fresh HeadObject check against the current clock.
  evidence  Json?
  createdAt DateTime  @default(now())
  /// Set atomically with the audit insert (exact-one-row gate).
  completedAt DateTime?

  @@unique([r2Key, eventNo])
  @@index([completedAt])
  // Raw partial unique index (hand-written in the migration): at most ONE
  // pending event per key at any time — Prisma PSL cannot express it.
  //   CREATE UNIQUE INDEX "StorageDeletionReceipt_onePending"
  //     ON "StorageDeletionReceipt"("r2Key") WHERE "completedAt" IS NULL;
}

/// Permanent key tombstones: existence = "issued once, never reusable".
/// Deliberately has NO status field and NO delete path anywhere in the
/// codebase — retiring a key is implicit (the row outlives its DentalFile).
model R2KeyRegistry {
  r2Key      String   @id
  reservedAt DateTime @default(now())
}
